# ── Database ───────────────────────────────────────────────
POSTGRES_DB=medcareaxis
POSTGRES_USER=medcareaxis_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── ASP.NET Core overrides (double-underscore = colon separator) ──
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=medcareaxis;Username=medcareaxis_user;Password=CHANGE_ME_STRONG_PASSWORD

JwtSettings__SecretKey=CHANGE_ME_64_CHAR_RANDOM_STRING_HERE
JwtSettings__Issuer=MedCareAxis
JwtSettings__Audience=MedCareAxis_Users
JwtSettings__ExpiryMinutes=480

SuperAdmin__Email=admin@medcareaxis.com
SuperAdmin__Password=CHANGE_ME_STRONG_PASSWORD

HospitalSettings__HospitalName=MedCareAxis
HospitalSettings__HospitalCode=MCA001

# ── CORS (comma-separated, no spaces) — override only if the prod domains change ──
Cors__AllowedOrigins=https://medcareaxis.com,https://www.medcareaxis.com,https://portal.medcareaxis.com

# ── Email (use Gmail App Password or SendGrid SMTP) ────────
Email__Host=smtp.gmail.com
Email__Port=587
Email__Username=your@gmail.com
Email__Password=your_app_password
Email__From=noreply@medcareaxis.com
Email__FromName=MedCareAxis

# ── Sentry (paste DSN from sentry.io project settings) ────
Sentry__Dsn=https://XXXXXX@oXXXXXX.ingest.sentry.io/XXXXXXX

# ── MSG91 (patient login OTP via SMS) — leave AuthKey blank to log OTPs instead of sending ──
Msg91__AuthKey=
Msg91__TemplateId=

# ── OTP hashing pepper — change to a random string in production ──
OtpSettings__Pepper=CHANGE_ME_RANDOM_STRING

# ── Cloudflare R2 (patient document storage, S3-compatible) ──
R2__AccountId=
R2__AccessKeyId=
R2__SecretAccessKey=
R2__BucketName=medcareaxis-documents

# ── ASPNETCORE ─────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5200
